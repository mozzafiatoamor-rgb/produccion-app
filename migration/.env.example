# Copia este archivo a migration/.env (NO se sube a git) y llena los valores.
# --- Origen: Google Sheets (solo lectura) ---
GOOGLE_SHEET_ID=
GOOGLE_API_KEY=
# --- Destino: Supabase (proyecto NUEVO / de pruebas) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Esquema propio donde se instalo supabase/schema.sql (dejar asi si no lo cambiaste)
SUPABASE_SCHEMA=produccion_app
# Llave PUBLICA (sb_publishable_... o anon). Es la que usara la app; la usa `check.mjs`.
SUPABASE_ANON_KEY=
# service_role key: SOLO para este script en tu computadora. Nunca en index.html.
SUPABASE_SERVICE_KEY=
